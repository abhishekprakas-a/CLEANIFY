# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Water Tank Cleaning Service"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (MongoDB / Mongoose)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/waterTankCleaning
MONGODB_DB_NAME=waterTankCleaning

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Use a long random string. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_NAME=wtcs_token
AUTH_REFRESH_COOKIE_NAME=wtcs_refresh
# Refresh-token (session) lifetime in days; the "remember me" variant is longer.
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30
# How long a password-reset link stays valid (minutes).
PASSWORD_RESET_EXPIRES_MINUTES=30

# ---------------------------------------------------------------------------
# Object storage for before/after job photos (AWS S3)
# ---------------------------------------------------------------------------
# Technicians upload before/after photos straight to this bucket via presigned
# URLs; admins then review them.
#
# Leave S3_ENDPOINT empty for AWS S3 (the SDK derives the host from the region).
# S3_REGION is the bucket's region (e.g. ap-south-1 for Mumbai).
# S3_PUBLIC_BASE_URL = https://<bucket>.s3.<region>.amazonaws.com
# The ACCESS KEY ID + SECRET must be AWS IAM S3 credentials with s3:PutObject
# and s3:GetObject on the bucket. The bucket needs a CORS rule allowing PUT/GET
# from the app origin, plus public read (or served via a CDN) for display.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=replace_me
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_PUBLIC_BASE_URL=https://replace_me
# Path-style addressing: false for AWS S3, true for MinIO and some hosts.
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_EXPIRES_SECONDS=300

# ---------------------------------------------------------------------------
# Web Push (PWA notifications) — optional. Generate with:
#   npx web-push generate-vapid-keys
# Push is disabled until both keys are set.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@watertank.local

# ---------------------------------------------------------------------------
# Seeding (initial admin account created by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@watertank.local
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=ChangeMe@123
